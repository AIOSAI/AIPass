{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Write(.claude/hooks/probes/**)",
      "Edit(.claude/hooks/probes/**)",
      "Bash(mkdir*)"
    ],
    "deny": [
      "EnterPlanMode",
      "Bash(git *)",
      "Bash(drone @git checkout main)"
    ],
    "defaultMode": "acceptEdits"
  },
  "skipDangerousModePermissionPrompt": true,
  "includeGitInstructions": false
}
