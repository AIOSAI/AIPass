# Outer build tooling for e2e-wheel.yml, hash-pinned (Scorecard:
# Pinned-Dependencies).
#
# Target env: ubuntu-latest, Python 3.12.
# conftest.py builds the wheel + a clean venv internally; the outer env only
# needs build + pytest.
#
# Python 3.12 is likewise load-bearing: pytest's `exceptiongroup`/`tomli` and
# build's `tomli` are gated on python_version < "3.11" and are absent here. If
# the matrix ever drops below 3.11, regenerate on that target.
#
# Regenerate (on Linux, Python 3.12):
#   pip-compile --allow-unsafe --generate-hashes --no-emit-index-url --output-file=e2e.txt e2e.in
build==1.6.1
pytest==9.2.0
